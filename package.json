{
  "name": "test",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -b && vite build",
    "dev": "vite",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "test": "bun test src",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install chromium",
    "test:e2e:ui": "playwright test --ui",
    "ts:check": "tsc --noEmit",
    "prepare": "bun -e \"import { execSync } from 'node:child_process'; if (process.env.NODE_ENV !== 'production' && process.env.CI !== 'true') execSync('husky .husky', { stdio: 'inherit', shell: true });\""
  },
  "dependencies": {
    "@base-ui/react": "1.6.0",
    "@fontsource-variable/roboto": "5.3.0",
    "@fontsource-variable/roboto-slab": "5.3.0",
    "@hookform/resolvers": "5.5.7",
    "@hugeicons/core-free-icons": "4.2.3",
    "@hugeicons/react": "1.1.9",
    "@tanstack/react-query": "5.101.4",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "isbot": "5.1.36",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-hook-form": "7.83.0",
    "react-router": "8.3.0",
    "shadcn": "4.16.0",
    "tailwind-merge": "3.6.0",
    "tw-animate-css": "1.4.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@babel/core": "8.0.1",
    "@happy-dom/global-registrator": "20.11.1",
    "@playwright/test": "1.62.0",
    "@rolldown/plugin-babel": "0.2.3",
    "@tailwindcss/vite": "4.2.2",
    "@tanstack/react-query-devtools": "5.101.4",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/babel__core": "7.20.5",
    "@types/bun": "1.3.14",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.4",
    "babel-plugin-react-compiler": "1.0.0",
    "husky": "9.1.7",
    "lint-staged": "17.2.0",
    "msw": "2.15.0",
    "oxfmt": "0.61.0",
    "oxlint": "1.76.0",
    "oxlint-tsgolint": "7.0.2001",
    "tailwindcss": "4.2.2",
    "typescript": "5.9.3",
    "vite": "8.0.3"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
